# ---------------------------------------------------------------------------
# Desafio Empreende - variaveis de PRODUCAO (VPS)
#
# Copie para .env no servidor. O scripts/deploy.sh cria este arquivo sozinho na
# primeira execucao, ja com POSTGRES_PASSWORD e JWT_SECRET aleatorios.
#
# O dominio e o certificado NAO aparecem aqui: quem cuida deles e a borda Caddy
# compartilhada da VPS (/opt/quiron/prod/proxy). Este stack so registra o
# apelido `desafio-web` na rede `quiron-borda` e espera a borda chamar.
# ---------------------------------------------------------------------------

# --- Banco de dados --------------------------------------------------------
POSTGRES_DB=desafio_empreende
POSTGRES_USER=empreende
# TROQUE. Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# Loopback: acessivel no servidor (psql, backup, tunel SSH), nunca da internet.
#   ssh -p 22022 -L 5433:127.0.0.1:5433 root@143.95.163.57
POSTGRES_PORT_HOST=127.0.0.1:5433

# --- Backend ---------------------------------------------------------------
NODE_ENV=production
API_PORT=3001
# TROQUE. Gere com: openssl rand -hex 32
# O login e feito apenas pelo nome (sem senha): este segredo e o unico controle
# de sessao do sistema, entao vazar ele equivale a vazar todas as contas.
JWT_SECRET=
JWT_EXPIRES_IN=8h
DB_LOGGING=false

# Front e API respondem sob a mesma origem (a borda), entao o CORS pode ser
# restrito ao proprio dominio.
CORS_ORIGIN=https://desafio.fronteiratec.com

# --- Migrations e seeds ----------------------------------------------------
RUN_MIGRATIONS=true
# Sobe com os dados de demonstracao. O seed e idempotente (rodar de novo nao
# duplica). Para operacao real, troque para false e cadastre os dados pelo
# sistema, entrando como INNE -- esse usuario vem da migration, nao do seed.
RUN_SEEDS=true

# --- Nginx interno ---------------------------------------------------------
# So o loopback: a internet chega pela borda, pela rede `quiron-borda`. Serve
# para depurar no proprio servidor (curl 127.0.0.1:8080) sem passar pelo TLS.
# Nao troque por "8080" puro, ou o sistema passa a responder tambem em
# http://143.95.163.57:8080 sem TLS e fora da borda.
WEB_PORT=127.0.0.1:8080

# --- Tetos de memoria ------------------------------------------------------
# A VPS tem 2 GB, 1 vCPU e ja roda a producao do Quiron. Estes limites existem
# para que um problema neste sistema nao derrube o do vizinho.
LIMITE_POSTGRES=256m
LIMITE_BACKEND=384m
LIMITE_FRONTEND=64m
LIMITE_NGINX=64m
