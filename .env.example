# ---------------------------------------------------------------------------
# Desafio Empreende - variaveis de ambiente
# Copie para .env (docker compose le este arquivo automaticamente).
# ---------------------------------------------------------------------------

# Banco de dados
POSTGRES_DB=desafio_empreende
POSTGRES_USER=empreende
POSTGRES_PASSWORD=troque-esta-senha
# Porta exposta no host para acessar o Postgres com um cliente externo
POSTGRES_PORT_HOST=5433

# Backend
NODE_ENV=production
API_PORT=3001
# Segredo do JWT: gere um valor aleatorio (ex.: openssl rand -hex 32)
# O login e feito apenas pelo nome (sem senha); o token assinado com este
# segredo e o unico controle de sessao, entao ele precisa ser secreto.
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*
DB_LOGGING=false

# Executa as migrations ao subir o container (recomendado)
RUN_MIGRATIONS=true
# Popula o banco com dados de demonstracao. Use false em producao.
RUN_SEEDS=true

# Nginx (porta de acesso ao sistema)
WEB_PORT=8080
